<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FacturaPDF.ViewModels"
             xmlns:converters="clr-namespace:FacturaPDF.Converters"
             x:Class="FacturaPDF.Views.WizardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D1117">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StepColorConverter x:Key="Step1ColorConverter" TargetStep="1"/>
            <converters:StepColorConverter x:Key="Step2ColorConverter" TargetStep="2"/>
            <converters:StepColorConverter x:Key="Step3ColorConverter" TargetStep="3"/>
            <converters:StepColorConverter x:Key="Step4ColorConverter" TargetStep="4"/>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            <converters:StepGreaterThanOneConverter x:Key="StepGreaterThanOneConverter"/>
            <converters:StepLessThanFourConverter x:Key="StepLessThanFourConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView VerticalOptions="CenterAndExpand">
        <VerticalStackLayout Spacing="30" Padding="30" MaximumWidthRequest="550" HorizontalOptions="CenterAndExpand">
            
            <!-- Cabecera / Identidad Premium -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="📄 FacturaPDF" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       TextColor="#52B788" 
                       HorizontalOptions="Center"/>
                <Label Text="Asistente de Configuración Inicial" 
                       FontSize="16" 
                       TextColor="#8B949E" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Indicador Visual de Pasos (Stepper) -->
            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="10" HorizontalOptions="FillAndExpand">
                <!-- Paso 1 -->
                <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{Binding CurrentStep, Converter={StaticResource Key=Step1ColorConverter}}" StrokeShape="RoundRectangle 8" Padding="10, 8">
                    <Label Text="1. Registro" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                </Border>
                <!-- Paso 2 -->
                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{Binding CurrentStep, Converter={StaticResource Key=Step2ColorConverter}}" StrokeShape="RoundRectangle 8" Padding="10, 8">
                    <Label Text="2. Rutas/Logo" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                </Border>
                <!-- Paso 3 -->
                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{Binding CurrentStep, Converter={StaticResource Key=Step3ColorConverter}}" StrokeShape="RoundRectangle 8" Padding="10, 8">
                    <Label Text="3. Plantillas" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                </Border>
                <!-- Paso 4 -->
                <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="{Binding CurrentStep, Converter={StaticResource Key=Step4ColorConverter}}" StrokeShape="RoundRectangle 8" Padding="10, 8">
                    <Label Text="4. Confirmar" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                </Border>
            </Grid>

            <!-- Título del Paso Activo -->
            <Label Text="{Binding StepTitle}" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   HorizontalOptions="Start"/>

            <!-- CONTENEDOR PRINCIPAL DEL PASO ACTIVO (Tarjeta Glassmorphism) -->
            <Border StrokeThickness="1" 
                    Stroke="#21262D" 
                    BackgroundColor="#161B22" 
                    StrokeShape="RoundRectangle 16" 
                    Padding="25">
                
                <Grid>
                    <!-- ================= PASO 1: AUTENTICACIÓN ================= -->
                    <VerticalStackLayout Spacing="15" IsVisible="{Binding IsStep1Visible}">
                        <Label Text="Introduce tus credenciales de acceso para la aplicación. La contraseña debe tener al menos 6 caracteres." 
                               TextColor="#8B949E" 
                               FontSize="13"/>
                        
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Correo Electrónico" TextColor="#C9D1D9" FontSize="14" FontAttributes="Bold"/>
                            <Border StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117">
                                <Entry Text="{Binding Email}" 
                                       Placeholder="ejemplo@correo.com" 
                                       TextColor="White" 
                                       PlaceholderColor="#484F58" 
                                       Keyboard="Email" 
                                       Margin="5,0"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Contraseña del Sistema" TextColor="#C9D1D9" FontSize="14" FontAttributes="Bold"/>
                            <Border StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117">
                                <Entry Text="{Binding Password}" 
                                       Placeholder="••••••••" 
                                       IsPassword="True" 
                                       TextColor="White" 
                                       PlaceholderColor="#484F58" 
                                       Margin="5,0"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ================= PASO 2: SELECCIÓN DE RUTAS Y LOGO ================= -->
                    <VerticalStackLayout Spacing="20" IsVisible="{Binding IsStep2Visible}">
                        <Label Text="Configura las ubicaciones de trabajo de FacturaPDF y el logotipo que se mostrará en los archivos generados." 
                               TextColor="#8B949E" 
                               FontSize="13"/>

                        <!-- Carpeta de Entrada -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Carpeta de Entrada (XMLs)" TextColor="#C9D1D9" FontSize="14" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0">
                                    <Label Text="{Binding SourceFolderPath, TargetNullValue='No seleccionada'}" 
                                           TextColor="White" 
                                           VerticalOptions="Center" 
                                           LineBreakMode="HeadTruncation" 
                                           FontSize="13"/>
                                </Border>
                                <Button Grid.Column="1" 
                                        Text="Examinar..." 
                                        Command="{Binding SelectSourceFolderCommand}" 
                                        BackgroundColor="#21262D" 
                                        TextColor="White" 
                                        CornerRadius="8" 
                                        Padding="15,0"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Carpeta de Salida -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Carpeta de Salida (PDFs)" TextColor="#C9D1D9" FontSize="14" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0">
                                    <Label Text="{Binding OutputFolderPath, TargetNullValue='No seleccionada'}" 
                                           TextColor="White" 
                                           VerticalOptions="Center" 
                                           LineBreakMode="HeadTruncation" 
                                           FontSize="13"/>
                                </Border>
                                <Button Grid.Column="1" 
                                        Text="Examinar..." 
                                        Command="{Binding SelectOutputFolderCommand}" 
                                        BackgroundColor="#21262D" 
                                        TextColor="White" 
                                        CornerRadius="8" 
                                        Padding="15,0"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Logotipo del Cliente (Opcional) -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Logotipo de la Empresa (Opcional)" TextColor="#C9D1D9" FontSize="14" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0">
                                    <Label Text="{Binding LogoPath, TargetNullValue='Sin logotipo personalizado'}" 
                                           TextColor="White" 
                                           VerticalOptions="Center" 
                                           LineBreakMode="HeadTruncation" 
                                           FontSize="13"/>
                                </Border>
                                <Button Grid.Column="1" 
                                        Text="Examinar..." 
                                        Command="{Binding SelectLogoCommand}" 
                                        BackgroundColor="#21262D" 
                                        TextColor="White" 
                                        CornerRadius="8" 
                                        Padding="15,0"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ================= PASO 3: CONFIGURACIÓN DE PLANTILLAS PDF ================= -->
                    <VerticalStackLayout Spacing="15" IsVisible="{Binding IsStep3Visible}">
                        <Label Text="Configura una plantilla global única o plantillas personalizadas específicas por tipo de comprobante. Si dejas una ruta vacía, se utilizará la plantilla por defecto." 
                               TextColor="#8B949E" 
                               FontSize="13"/>

                        <!-- Plantilla Global -->
                        <Label Text="Plantilla Global" TextColor="#52B788" FontSize="15" FontAttributes="Bold" Margin="0, 5, 0, 0"/>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Ruta" TextColor="#C9D1D9" FontSize="13"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0">
                                    <Label Text="{Binding CustomXsltPath, TargetNullValue='No seleccionada (Usar integrada por defecto)'}" 
                                           TextColor="White" 
                                           VerticalOptions="Center" 
                                           LineBreakMode="HeadTruncation" 
                                           FontSize="13"/>
                                </Border>
                                <Button Grid.Column="1" 
                                        Text="BUSCAR" 
                                        Command="{Binding SelectXsltFileCommand}" 
                                        BackgroundColor="#21262D" 
                                        TextColor="White" 
                                        CornerRadius="8" 
                                        Padding="15,0"/>
                            </Grid>
                        </VerticalStackLayout>

                        <Border StrokeThickness="0" HeightRequest="1" BackgroundColor="#21262D" Margin="0, 10"/>

                        <!-- Plantillas por Comprobante -->
                        <Label Text="Plantilla por comprobante" TextColor="#52B788" FontSize="15" FontAttributes="Bold"/>

                        <!-- Factura Ingreso -->
                        <Grid ColumnDefinitions="140, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Factura Ingreso" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                            <Border Grid.Column="1" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0" HeightRequest="38">
                                <Label Text="{Binding XsltIngresoPath, TargetNullValue='Usar global / integrada'}" 
                                       TextColor="White" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="HeadTruncation" 
                                       FontSize="12"/>
                            </Border>
                            <Button Grid.Column="2" 
                                    Text="BUSCAR" 
                                    Command="{Binding SelectXsltIngresoCommand}" 
                                    BackgroundColor="#21262D" 
                                    TextColor="White" 
                                    CornerRadius="8" 
                                    HeightRequest="38"
                                    Padding="15,0"/>
                        </Grid>

                        <!-- Carta Porte -->
                        <Grid ColumnDefinitions="140, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Carta Porte" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                            <Border Grid.Column="1" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0" HeightRequest="38">
                                <Label Text="{Binding XsltCartaPortePath, TargetNullValue='Usar global / integrada'}" 
                                       TextColor="White" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="HeadTruncation" 
                                       FontSize="12"/>
                            </Border>
                            <Button Grid.Column="2" 
                                    Text="BUSCAR" 
                                    Command="{Binding SelectXsltCartaPorteCommand}" 
                                    BackgroundColor="#21262D" 
                                    TextColor="White" 
                                    CornerRadius="8" 
                                    HeightRequest="38"
                                    Padding="15,0"/>
                        </Grid>

                        <!-- Pagos -->
                        <Grid ColumnDefinitions="140, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Pagos" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                            <Border Grid.Column="1" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0" HeightRequest="38">
                                <Label Text="{Binding XsltPagoPath, TargetNullValue='Usar global / integrada'}" 
                                       TextColor="White" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="HeadTruncation" 
                                       FontSize="12"/>
                            </Border>
                            <Button Grid.Column="2" 
                                    Text="BUSCAR" 
                                    Command="{Binding SelectXsltPagoCommand}" 
                                    BackgroundColor="#21262D" 
                                    TextColor="White" 
                                    CornerRadius="8" 
                                    HeightRequest="38"
                                    Padding="15,0"/>
                        </Grid>

                        <!-- Nómina -->
                        <Grid ColumnDefinitions="140, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Nómina" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                            <Border Grid.Column="1" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0" HeightRequest="38">
                                <Label Text="{Binding XsltNominaPath, TargetNullValue='Usar global / integrada'}" 
                                       TextColor="White" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="HeadTruncation" 
                                       FontSize="12"/>
                            </Border>
                            <Button Grid.Column="2" 
                                    Text="BUSCAR" 
                                    Command="{Binding SelectXsltNominaCommand}" 
                                    BackgroundColor="#21262D" 
                                    TextColor="White" 
                                    CornerRadius="8" 
                                    HeightRequest="38"
                                    Padding="15,0"/>
                        </Grid>

                        <!-- Comercio Exterior -->
                        <Grid ColumnDefinitions="140, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Comercio Exterior" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                            <Border Grid.Column="1" StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="10, 0" HeightRequest="38">
                                <Label Text="{Binding XsltComercioExteriorPath, TargetNullValue='Usar global / integrada'}" 
                                       TextColor="White" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="HeadTruncation" 
                                       FontSize="12"/>
                            </Border>
                            <Button Grid.Column="2" 
                                    Text="BUSCAR" 
                                    Command="{Binding SelectXsltComercioExteriorCommand}" 
                                    BackgroundColor="#21262D" 
                                    TextColor="White" 
                                    CornerRadius="8" 
                                    HeightRequest="38"
                                    Padding="15,0"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ================= PASO 4: CONFIRMACIÓN ================= -->
                    <VerticalStackLayout Spacing="15" IsVisible="{Binding IsStep4Visible}">
                        <Label Text="¡Todo está listo! Confirma que los datos ingresados sean correctos antes de inicializar la aplicación." 
                               TextColor="#8B949E" 
                               FontSize="13"/>

                        <Border StrokeThickness="1" Stroke="#30363D" StrokeShape="RoundRectangle 8" BackgroundColor="#0D1117" Padding="15">
                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="📧 Correo:" FontAttributes="Bold" TextColor="#52B788" WidthRequest="110"/>
                                    <Label Text="{Binding Email}" TextColor="White"/>
                                </HorizontalStackLayout>
                                
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="📥 Entrada:" FontAttributes="Bold" TextColor="#52B788" WidthRequest="110"/>
                                    <Label Text="{Binding SourceFolderPath}" TextColor="White" LineBreakMode="CharacterWrap"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="📤 Salida:" FontAttributes="Bold" TextColor="#52B788" WidthRequest="110"/>
                                    <Label Text="{Binding OutputFolderPath}" TextColor="White" LineBreakMode="CharacterWrap"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="🖼️ Logotipo:" FontAttributes="Bold" TextColor="#52B788" WidthRequest="110"/>
                                    <Label Text="{Binding LogoPath, TargetNullValue='Sin logotipo personalizado'}" TextColor="White" LineBreakMode="CharacterWrap"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="📄 XSLT Global:" FontAttributes="Bold" TextColor="#52B788" WidthRequest="110"/>
                                    <Label Text="{Binding CustomXsltPath, TargetNullValue='Por defecto integrada en la app'}" TextColor="#8B949E" LineBreakMode="CharacterWrap"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="* Al inicializar, la app creará automáticamente las subcarpetas 'Procesados' y 'Errores' dentro del directorio de entrada seleccionado." 
                               TextColor="#8B949E" 
                               FontSize="11" 
                               FontAttributes="Italic"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Mensaje de Error Informativo -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="#FF4D4D" 
                   FontSize="13" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource Key=StringNotEmptyConverter}}"/>

            <!-- BOTONES DE NAVEGACIÓN INFERIOR -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <!-- Botón Atrás -->
                <Button Grid.Column="0" 
                        Text="Atrás" 
                        Command="{Binding PreviousStepCommand}" 
                        IsVisible="{Binding CurrentStep, Converter={StaticResource Key=StepGreaterThanOneConverter}}" 
                        BackgroundColor="#21262D" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HeightRequest="45"/>
                
                <!-- Botón Siguiente (Pasos 1, 2 y 3) -->
                <Button Grid.Column="1" 
                        Text="Siguiente" 
                        Command="{Binding NextStepCommand}" 
                        IsVisible="{Binding CurrentStep, Converter={StaticResource Key=StepLessThanFourConverter}}" 
                        BackgroundColor="#52B788" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="8" 
                        HeightRequest="45"/>

                <!-- Botón Finalizar (Paso 4) -->
                <Button Grid.Column="1" 
                        Text="Inicializar App" 
                        Command="{Binding FinishConfigurationCommand}" 
                        IsVisible="{Binding IsStep4Visible}" 
                        BackgroundColor="#52B788" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="8" 
                        HeightRequest="45"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
