<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FacturaPDF.ViewModels"
             xmlns:models="clr-namespace:FacturaPDF.Models"
             xmlns:converters="clr-namespace:FacturaPDF.Converters"
             x:Class="FacturaPDF.MainPage"
             Title="XML Processor Pro"
             BackgroundColor="{DynamicResource PageBg}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>

            <!-- Dynamic Theme Resources (Default: Dark Mode) -->
            <Color x:Key="PageBg">#0B0F19</Color>
            <Color x:Key="SidebarBg">#111625</Color>
            <Color x:Key="CardBg">#111625</Color>
            <Color x:Key="BorderColor">#222D42</Color>
            <Color x:Key="PrimaryText">#FFFFFF</Color>
            <Color x:Key="SecondaryText">#94A3B8</Color>
            <Color x:Key="MutedText">#64748B</Color>
            <Color x:Key="PanelBg">#0B0F19</Color>
            <Color x:Key="HoverBg">#1E293B</Color>
            
            <!-- Estilo Reusable para Botón Browse Secundario con Hover Elegante -->
            <Style x:Key="BrowseButtonStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}"/>
                <Setter Property="Stroke" Value="{DynamicResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
                <Setter Property="Padding" Value="15, 0"/>
                <Setter Property="HeightRequest" Value="42"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource HoverBg}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Estilo Reusable para Botón de Acción Común con Hover Elegante -->
            <Style x:Key="HeaderActionButtonStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource SidebarBg}"/>
                <Setter Property="Stroke" Value="{DynamicResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
                <Setter Property="Padding" Value="15, 8"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SidebarBg}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource HoverBg}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Estructura Principal: Sidebar Izquierdo (260px) + Panel de Contenido Derecho (*) -->
    <Grid ColumnDefinitions="260, *">
        <!-- Motor de Renderizado Invisible (Garantiza inicialización en el Visual Tree) -->
        <WebView x:Name="pdfWebView" WidthRequest="1" HeightRequest="1" Opacity="0" HorizontalOptions="Start" VerticalOptions="Start"/>

        <!-- ================= COLUMNA 0: BARRA LATERAL (SIDEBAR) ================= -->
        <Grid Grid.Column="0" BackgroundColor="{DynamicResource SidebarBg}" RowDefinitions="Auto, *, Auto" Padding="0, 20">
            <!-- 1. Cabecera del Sidebar -->
            <VerticalStackLayout Grid.Row="0" Spacing="5" Padding="25, 10">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <!-- Icono Vectorial del Procesador -->
                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                          Fill="#3B82F6"
                          HeightRequest="22"
                          WidthRequest="22"
                          Aspect="Uniform"
                          VerticalOptions="Center"/>
                    <Label Text="XML Processor" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border StrokeThickness="0" HeightRequest="1" BackgroundColor="#222D42" Margin="0, 15, 0, 0"/>
            </VerticalStackLayout>

            <!-- 2. Menú de Navegación -->
            <VerticalStackLayout Grid.Row="1" Spacing="8" Padding="10, 10">
                <!-- Botón Dashboard (Reactivo con Triggers y Hover) -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="15, 12" Margin="10, 2" HeightRequest="45" ToolTipProperties.Text="Ver panel de control principal">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchViewCommand}" CommandParameter="Dashboard"/>
                    </Border.GestureRecognizers>
                    <Border.VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#1E293B"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </Border.VisualStateManager.VisualStateGroups>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDashboardViewActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#3B82F6"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                        <Path Grid.Column="0" 
                              Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" 
                              WidthRequest="16" 
                              HeightRequest="16"
                              Aspect="Uniform"
                              VerticalOptions="Center">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding IsDashboardViewActive}" Value="True">
                                    <Setter Property="Fill" Value="#FFFFFF"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Path" Binding="{Binding IsDashboardViewActive}" Value="False">
                                    <Setter Property="Fill" Value="#94A3B8"/>
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                        <Label Grid.Column="1" 
                               Text="Dashboard" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDashboardViewActive}" Value="True">
                                    <Setter Property="TextColor" Value="#FFFFFF"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDashboardViewActive}" Value="False">
                                    <Setter Property="TextColor" Value="#94A3B8"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </Border>

                <!-- Botón Log / Bitácora (Reactivo con Triggers y Hover) -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="15, 12" Margin="10, 2" HeightRequest="45" ToolTipProperties.Text="Ver historial de errores y observabilidad">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchViewCommand}" CommandParameter="Log"/>
                    </Border.GestureRecognizers>
                    <Border.VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#1E293B"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </Border.VisualStateManager.VisualStateGroups>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDashboardViewActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#3B82F6"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                        <Path Grid.Column="0" 
                              Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" 
                              WidthRequest="16" 
                              HeightRequest="16"
                              Aspect="Uniform"
                              VerticalOptions="Center">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding IsDashboardViewActive}" Value="False">
                                    <Setter Property="Fill" Value="#FFFFFF"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Path" Binding="{Binding IsDashboardViewActive}" Value="True">
                                    <Setter Property="Fill" Value="#94A3B8"/>
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                        <Label Grid.Column="1" 
                               Text="Log / Bitácora" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDashboardViewActive}" Value="False">
                                    <Setter Property="TextColor" Value="#FFFFFF"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDashboardViewActive}" Value="True">
                                    <Setter Property="TextColor" Value="#94A3B8"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- 3. Perfil de Usuario e Información Global Bottom -->
            <VerticalStackLayout Grid.Row="2" Spacing="10" Padding="15, 10">
                <Border StrokeThickness="0" HeightRequest="1" BackgroundColor="#222D42" Margin="0,0,0,10"/>
                
                <!-- Tarjeta de Perfil -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Margin="10, 0, 10, 10" ToolTipProperties.Text="Sesión activa del Administrador del Sistema">
                    <!-- Avatar con Iniciales Estilizado -->
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="#1E293B" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="MH" FontSize="13" FontAttributes="Bold" TextColor="#3B82F6" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <!-- Nombre y Rol -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Manuel H" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="System Administrator" FontSize="10" TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Settings, Clear DB & Help Buttons -->
                <Grid ColumnDefinitions="*, *, *" Margin="5,0">
                    <!-- Settings (Reconfigurar) -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="5" HorizontalOptions="Center" ToolTipProperties.Text="Borrar configuración e iniciar asistente">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetApplicationCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.44.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                              Fill="#94A3B8" WidthRequest="13" HeightRequest="13" Aspect="Uniform" VerticalOptions="Center"/>
                        <Label Text="Settings" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <!-- Clear DB (Vaciar Historial) -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="Center" ToolTipProperties.Text="Vaciar base de datos del historial de por vida">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearLifetimeHistoryCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                              Fill="#EF4444" WidthRequest="13" HeightRequest="13" Aspect="Uniform" VerticalOptions="Center"/>
                        <Label Text="Clear DB" FontSize="10" TextColor="#EF4444" VerticalOptions="Center" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <!-- Help -->
                    <HorizontalStackLayout Grid.Column="2" Spacing="5" HorizontalOptions="Center" ToolTipProperties.Text="Ver documentación o ayuda del sistema">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm1.07-7.75l-.9.92C12.45 11.9 12 12.5 12 14h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"
                              Fill="#94A3B8" WidthRequest="13" HeightRequest="13" Aspect="Uniform" VerticalOptions="Center"/>
                        <Label Text="Help" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>
          <!-- ================= COLUMNA 1: CONTENIDO DERECHO ================= -->
        <Grid Grid.Column="1" BackgroundColor="{DynamicResource PageBg}">
            
            <!-- ================= SUB-PANEL A: DASHBOARD VIEW ================= -->
            <Grid IsVisible="{Binding IsDashboardViewActive}" RowDefinitions="Auto, Auto, Auto, *" Padding="25" RowSpacing="20">
                
                <!-- Row 0: Cabecera Superior del Dashboard -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="XML Processor Pro" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource PrimaryText}" VerticalOptions="Center"/>
                        <!-- Pill de Versión -->
                        <Border BackgroundColor="{DynamicResource HoverBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8, 3" VerticalOptions="Center" ToolTipProperties.Text="Versión actual instalada de FacturaPDF">
                            <Label Text="v2.4.0" FontSize="11" TextColor="{DynamicResource SecondaryText}" FontAttributes="Bold"/>
                        </Border>
                    </HorizontalStackLayout>
 
                    <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                        <!-- Barra de Búsqueda -->
                        <Border BackgroundColor="{DynamicResource SidebarBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="15, 0" WidthRequest="220" HeightRequest="36" ToolTipProperties.Text="Buscar facturas o procesos en tiempo real">
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="{DynamicResource MutedText}" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1" Placeholder="Search processes..." TextColor="{DynamicResource PrimaryText}" PlaceholderColor="{DynamicResource MutedText}" FontSize="12" Margin="0" BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>
                        <!-- Botón de Alternancia de Tema (Claro / Oscuro) -->
                        <Border BackgroundColor="{DynamicResource SidebarBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" ToolTipProperties.Text="Cambiar entre Modo Claro y Oscuro">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleThemeCommand}"/>
                            </Border.GestureRecognizers>
                            <Border.VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{DynamicResource HoverBg}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </Border.VisualStateManager.VisualStateGroups>
                            <Path Data="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.01c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z"
                                  Fill="{DynamicResource PrimaryText}" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding IsDarkMode}" Value="True">
                                        <!-- Moon SVG data on dark mode -->
                                        <Setter Property="Data" Value="M12.3 22h-.1c-5.5 0-10-4.5-10-10 0-4.8 3.5-8.9 8.2-9.8.6-.1 1.2.3 1.3.9.1.6-.3 1.2-.9 1.3-3.7.7-6.4 4-6.4 7.8 0 4.4 3.6 8 8 8 3.8 0 7.1-2.7 7.8-6.4.1-.6.7-1 1.3-.9.6.1 1 .7.9 1.3-.9 4.7-5 8.2-9.8 8.2z"/>
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                        </Border>
                        <!-- Campana de Notificación -->
                        <Grid WidthRequest="36" HeightRequest="36" ToolTipProperties.Text="Alertas y avisos del sistema">
                            <Border StrokeThickness="0" BackgroundColor="{DynamicResource SidebarBg}" StrokeShape="RoundRectangle 18" Padding="9">
                                <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5 1.5-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                                      Fill="{DynamicResource SecondaryText}" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <!-- Punto de Notificación Rojo -->
                            <Border WidthRequest="8" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="#EF4444" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start" Margin="0, 2, 2, 0"/>
                        </Grid>
                        <!-- Fecha -->
                        <Label Text="Oct 24, 2023" TextColor="{DynamicResource SecondaryText}" FontSize="13" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Row 1: Titulo Central y Estado del Servicio -->
                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0, 5, 0, 0">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Control Center" FontSize="26" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Monitoring automated XML to PDF conversion streams." FontSize="13" TextColor="#94A3B8"/>
                    </VerticalStackLayout>

                    <!-- Caja de Estado del Servicio Activo -->
                    <Border Grid.Column="1" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" BackgroundColor="{DynamicResource SidebarBg}" StrokeShape="RoundRectangle 12" Padding="15, 10" WidthRequest="260" HeightRequest="65" ToolTipProperties.Text="Activa o desactiva el servicio de escaneo automático">
                        <Grid ColumnDefinitions="*, 60" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="SERVICE STATUS" FontSize="10" TextColor="{DynamicResource MutedText}" FontAttributes="Bold"/>
                                <Label FontSize="14" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Text" Value="Active" />
                                            <Setter Property="TextColor" Value="#10B981" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Text" Value="Inactive" />
                                            <Setter Property="TextColor" Value="#EF4444" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding IsMonitoring}" 
                                    OnColor="#3B82F6"
                                    ThumbColor="White"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 2: Bloque Superior de Selección de Carpetas (2 Columnas) -->
                <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="20">
                    
                    <!-- Tarjeta Entrada XML -->
                    <Border Grid.Column="0" Stroke="#222D42" StrokeThickness="1" BackgroundColor="#111625" StrokeShape="RoundRectangle 12" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <!-- Cabecera -->
                            <HorizontalStackLayout Spacing="10">
                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" 
                                      Fill="#3B82F6" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center"/>
                                <Label Text="Source Folder (XML Input)" FontSize="14" FontAttributes="Bold" TextColor="#3B82F6" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            
                            <!-- Campo y Botón -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" BackgroundColor="#0B0F19" Stroke="#222D42" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12, 10" HeightRequest="42" ToolTipProperties.Text="Carpeta donde colocas los XML del SAT">
                                    <Label Text="{Binding Config.SourceFolderPath, TargetNullValue='No configurado'}" 
                                           TextColor="White" FontSize="12" VerticalOptions="Center" LineBreakMode="HeadTruncation"/>
                                </Border>
                                
                                <!-- Botón Browse XML con Hover Estilo BrowseButtonStyle -->
                                <Border Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" ToolTipProperties.Text="Examinar carpeta de Entrada XML">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectSourceFolderCommand}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                              Fill="White" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center"/>
                                        <Label Text="Browse" TextColor="White" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Label Text="Files added here will be automatically queued for processing." FontSize="10" TextColor="#64748B" FontAttributes="Italic"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tarjeta Salida PDF -->
                    <Border Grid.Column="1" Stroke="#222D42" StrokeThickness="1" BackgroundColor="#111625" StrokeShape="RoundRectangle 12" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <!-- Cabecera -->
                            <HorizontalStackLayout Spacing="10">
                                <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" 
                                      Fill="#10B981" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center"/>
                                <Label Text="Destination Folder (PDF Output)" FontSize="14" FontAttributes="Bold" TextColor="#10B981" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            
                            <!-- Campo y Botón -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" BackgroundColor="#0B0F19" Stroke="#222D42" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12, 10" HeightRequest="42" ToolTipProperties.Text="Carpeta donde se guardarán los archivos PDF resultantes">
                                    <Label Text="{Binding Config.OutputFolderPath, TargetNullValue='No configurado'}" 
                                           TextColor="White" FontSize="12" VerticalOptions="Center" LineBreakMode="HeadTruncation"/>
                                </Border>
                                
                                <!-- Botón Browse PDF con Hover -->
                                <Border Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" ToolTipProperties.Text="Examinar carpeta de Salida PDF">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectOutputFolderCommand}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                              Fill="White" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center"/>
                                        <Label Text="Browse" TextColor="White" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Label Text="Successfully converted PDF documents are deposited here." FontSize="10" TextColor="#64748B" FontAttributes="Italic"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Row 3: Listado de Archivos Procesados (Card Principal) -->
                <Border Grid.Row="3" Stroke="#222D42" StrokeThickness="1" BackgroundColor="#111625" StrokeShape="RoundRectangle 12" Padding="20">
                    <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="12">
                        <!-- Cabecera de la Tabla -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="10">
                                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" 
                                      Fill="White" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center"/>
                                <Label Text="Processed Files" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            
                            <!-- Acciones (Sort & Download Iconos) con Tooltips -->
                            <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                                <Path Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" Fill="#94A3B8" WidthRequest="16" HeightRequest="16" Aspect="Uniform" ToolTipProperties.Text="Ordenar historial de procesamiento"/>
                                <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" Fill="#94A3B8" WidthRequest="16" HeightRequest="16" Aspect="Uniform" ToolTipProperties.Text="Exportar historial completo a la nube"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Cabeceras de Columna -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, 180, 110, 100" Padding="10, 5" BackgroundColor="#0B0F19">
                            <Label Grid.Column="0" Text="FILE NAME" FontSize="10" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="TIMESTAMP" FontSize="10" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="STATUS" FontSize="10" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Grid.Column="3" Text="ACTIONS" FontSize="10" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Items Procesados -->
                        <CollectionView Grid.Row="2" ItemsSource="{Binding ProcessingHistory}">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="40" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                    <Path Data="M19 20H5V8H19M19 6H12L10 4H5A2 2 0 0 0 3 6V20A2 2 0 0 0 5 22H19A2 2 0 0 0 21 20V8A2 2 0 0 0 21 6Z" 
                                          Fill="#222D42" WidthRequest="32" HeightRequest="32" Aspect="Uniform" HorizontalOptions="Center"/>
                                    <Label Text="Historial vacío." TextColor="#94A3B8" FontSize="13" HorizontalOptions="Center"/>
                                    <Label Text="Los archivos XML procesados con éxito aparecerán aquí automáticamente." TextColor="#64748B" FontSize="11" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProcessedInvoice">
                                    <Border StrokeThickness="0" BackgroundColor="Transparent" Margin="0" Padding="10, 12">
                                        <Grid ColumnDefinitions="*, 180, 110, 100">
                                            <!-- Nombre de Archivo -->
                                            <Label Grid.Column="0" Text="{Binding FileName}" FontAttributes="Bold" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                            <!-- Marca de Tiempo -->
                                            <Label Grid.Column="1" Text="{Binding Timestamp, StringFormat='Generado con éxito a las {0}'}" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center"/>
                                            <!-- Badge Éxito -->
                                            <Border Grid.Column="2" StrokeThickness="1" Stroke="#10B981" BackgroundColor="#152C28" StrokeShape="RoundRectangle 12" Padding="10, 4" HorizontalOptions="Start" VerticalOptions="Center" ToolTipProperties.Text="Factura XML procesada y guardada como PDF con éxito">
                                                <Label Text="Success" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            
                                            <!-- Acciones con Iconos Descriptivos y Tooltips -->
                                            <HorizontalStackLayout Grid.Column="3" Spacing="15" HorizontalOptions="Center" VerticalOptions="Center">
                                                <!-- Abrir XML (<>) -->
                                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="5"
                                                        IsEnabled="{Binding IsXmlAvailable}"
                                                        Opacity="{Binding XmlIconOpacity}"
                                                        ToolTipProperties.Text="{Binding XmlTooltip}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenXmlCommand}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Path Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z" 
                                                          Fill="#3B82F6"
                                                          WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center"/>
                                                </Border>
                                                <!-- Abrir PDF (Icono PDF) -->
                                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="5"
                                                        IsEnabled="{Binding IsPdfAvailable}"
                                                        Opacity="{Binding PdfIconOpacity}"
                                                        ToolTipProperties.Text="{Binding PdfTooltip}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenPdfCommand}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" 
                                                          Fill="#10B981"
                                                          WidthRequest="14" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center"/>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Paginación / Resumen Dinámico -->
                        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Padding="0, 5, 0, 0">
                            <Label Grid.Column="0" Text="{Binding ProcessingHistory.Count, StringFormat='Showing {0} processed items'}" TextColor="#64748B" FontSize="12" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                                <Label Text="&lt;" TextColor="#64748B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="1" TextColor="White" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="&gt;" TextColor="#64748B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= SUB-PANEL B: LOG / BITÁCORA VIEW ================= -->
            <Grid IsVisible="{Binding IsDashboardViewActive, Converter={StaticResource Key=InvertedBoolConverter}}" RowDefinitions="Auto, Auto, Auto, *" Padding="25" RowSpacing="20">
                
                <!-- Row 0: Cabecera Superior del Log -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Log / Bitácora" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>

                    <!-- Buscador de eventos -->
                    <Border Grid.Column="1" BackgroundColor="#111625" Stroke="#222D42" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="15, 0" WidthRequest="260" HeightRequest="36" VerticalOptions="Center" ToolTipProperties.Text="Buscar un evento, error o archivo de log específico">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="#64748B" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1" Placeholder="Search events, errors, or files..." TextColor="White" PlaceholderColor="#64748B" FontSize="12" Margin="0" BackgroundColor="Transparent"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 1: Fila de Tarjetas Estadísticas (4 Columnas) -->
                <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *" ColumnSpacing="15">
                    
                    <!-- Tarjeta 1: Total Events -->
                    <Border Grid.Column="0" Stroke="#222D42" StrokeThickness="1" BackgroundColor="#111625" StrokeShape="RoundRectangle 12" Padding="15" ToolTipProperties.Text="Total de documentos procesados e intentados en la historia del directorio de entrada">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#1A2438" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10" WidthRequest="38" HeightRequest="38">
                                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" 
                                      Fill="White" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="TOTAL EVENTS" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8"/>
                                <Label Text="{Binding TotalEvents}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Tarjeta 2: Failed -->
                    <Border Grid.Column="1" Stroke="#222D42" StrokeThickness="1" BackgroundColor="#111625" StrokeShape="RoundRectangle 12" Padding="15" ToolTipProperties.Text="Facturas XML que presentaron algún fallo y residen en la carpeta de errores">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#2E1C21" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10" WidthRequest="38" HeightRequest="38">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                                      Fill="#EF4444" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="FAILED" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8"/>
                                <Label Text="{Binding RecentErrors.Count}" FontSize="18" FontAttributes="Bold" TextColor="#EF4444"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Tarjeta 3: In Progress -->
                    <Border Grid.Column="2" Stroke="#222D42" StrokeThickness="1" BackgroundColor="#111625" StrokeShape="RoundRectangle 12" Padding="15" ToolTipProperties.Text="Cantidad de facturas que se están convirtiendo en el hilo de segundo plano actualmente">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#182A45" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10" WidthRequest="38" HeightRequest="38">
                                <Path Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm-6 8c0-1.01.25-1.97.7-2.8L5.24 6.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3c-3.31 0-6-2.69-6-6z" 
                                      Fill="#3B82F6" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="IN PROGRESS" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8"/>
                                <Label Text="{Binding InProgressEvents}" FontSize="18" FontAttributes="Bold" TextColor="#3B82F6"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Tarjeta 4: Uptime -->
                    <Border Grid.Column="3" Stroke="#222D42" StrokeThickness="1" BackgroundColor="#111625" StrokeShape="RoundRectangle 12" Padding="15" ToolTipProperties.Text="Tasa de éxito o porcentaje de facturas procesadas exitosamente frente al total">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#172C24" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10" WidthRequest="38" HeightRequest="38">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" 
                                      Fill="#10B981" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="UPTIME" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8"/>
                                <Label Text="{Binding Uptime}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 2: Fila de Botones de Filtro y Acción con Hover Elegante -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="12">
                    <!-- Botón Filtrar Estado con Hover -->
                    <Border Grid.Column="0" Style="{StaticResource HeaderActionButtonStyle}" ToolTipProperties.Text="Ver solo eventos con estado de éxito o error">
                        <Label Text="Filter by Status" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                    </Border>
                    <!-- Botón Últimas 24 Horas con Hover -->
                    <Border Grid.Column="1" Style="{StaticResource HeaderActionButtonStyle}" ToolTipProperties.Text="Acotar la bitácora de eventos a las últimas 24 horas">
                        <Label Text="Last 24 Hours" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                    </Border>
                    
                    <!-- Botón Exportar Logs con Hover -->
                    <Border Grid.Column="3" StrokeShape="RoundRectangle 8" Padding="18, 8" ToolTipProperties.Text="Abrir el explorador de archivos en la carpeta física de errores para exportarlos">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFolderCommand}" CommandParameter="Errors"/>
                        </Border.GestureRecognizers>
                        <Border.VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#1E293B"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#2B3A52"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </Border.VisualStateManager.VisualStateGroups>
                        <HorizontalStackLayout Spacing="8">
                            <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" 
                                  Fill="White" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center"/>
                            <Label Text="Export Logs" TextColor="White" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Row 3: Listado de Errores y Logs Recientes (Card Principal) -->
                <Grid Grid.Row="3">
                    <Border Stroke="#222D42" StrokeThickness="1" BackgroundColor="#111625" StrokeShape="RoundRectangle 12" Padding="20">
                        <Grid RowDefinitions="Auto, *, Auto" RowSpacing="12">
                            <!-- Cabeceras de Columna -->
                            <Grid Grid.Row="0" ColumnDefinitions="40, 140, 90, 130, 180, *" Padding="10, 5" BackgroundColor="#0B0F19">
                                <Label Grid.Column="1" Text="TIMESTAMP" FontSize="10" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="EVENT ID" FontSize="10" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="3" Text="STATUS" FontSize="10" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="4" Text="FILE REFERENCE" FontSize="10" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="5" Text="ERROR DESCRIPTION" FontSize="10" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>

                            <!-- Items del Log de Errores -->
                            <CollectionView Grid.Row="1" ItemsSource="{Binding RecentErrors}">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Padding="50" HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                        <!-- Icono Éxito Total Vectorial (Check) -->
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" 
                                              Fill="#10B981" WidthRequest="36" HeightRequest="36" Aspect="Uniform" HorizontalOptions="Center"/>
                                        <Label Text="¡Cero Errores Activos!" TextColor="#10B981" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                                        <Label Text="Todos los XMLs procesados se han convertido exitosamente a PDF sin fallos." TextColor="#94A3B8" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ErrorLog">
                                        <!-- Fondo sutil rojizo para los errores críticos -->
                                        <Border StrokeThickness="0" BackgroundColor="#241416" Margin="0" Padding="10, 10">
                                            <Grid ColumnDefinitions="40, 140, 90, 130, 180, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="False" Color="#3B82F6" VerticalOptions="Center" HorizontalOptions="Center" ToolTipProperties.Text="Seleccionar log para operaciones grupales"/>
                                                <!-- Timestamp -->
                                                <Label Grid.Column="1" Text="{Binding Timestamp, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center"/>
                                                <!-- Event ID Dinámico -->
                                                <Label Grid.Column="2" Text="{Binding Timestamp, StringFormat='#EVT-{0:HHmmss}'}" TextColor="White" FontSize="11" VerticalOptions="Center"/>
                                                <!-- Badge CRITICAL ERROR -->
                                                <Border Grid.Column="3" StrokeThickness="1" Stroke="#EF4444" BackgroundColor="#351B21" StrokeShape="RoundRectangle 12" Padding="8, 3" HorizontalOptions="Start" VerticalOptions="Center" ToolTipProperties.Text="Fallo crítico al validar o compilar el documento XML">
                                                    <Label Text="CRITICAL ERROR" TextColor="#EF4444" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                <!-- File Reference -->
                                                <Label Grid.Column="4" Text="{Binding FileName}" FontAttributes="Bold" TextColor="White" FontSize="12" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                                <!-- Error Description -->
                                                <Label Grid.Column="5" Text="{Binding ErrorMessage}" TextColor="#F87171" FontSize="12" VerticalOptions="Center" LineBreakMode="WordWrap" MaxLines="2"/>
                                                
                                                <!-- Reprocess Button con Hover Clásico Rojo/Oscuro -->
                                                <Border Grid.Column="6" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="12, 6" Margin="0,0,10,0" VerticalOptions="Center" ToolTipProperties.Text="Mover de vuelta este XML al directorio de Entrada e intentar reprocesarlo de inmediato">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=RetryErrorCommand}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Border.VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroupList>
                                                            <VisualStateGroup Name="CommonStates">
                                                                <VisualState Name="Normal">
                                                                    <VisualState.Setters>
                                                                        <Setter Property="BackgroundColor" Value="#EF4444"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState Name="PointerOver">
                                                                    <VisualState.Setters>
                                                                        <Setter Property="BackgroundColor" Value="#DC2626"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateGroupList>
                                                    </Border.VisualStateManager.VisualStateGroups>
                                                    <Label Text="Reprocess" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Paginación Dinámica -->
                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Padding="0, 5, 0, 0">
                                <Label Grid.Column="0" Text="{Binding RecentErrors.Count, StringFormat='Showing {0} active error entries'}" TextColor="#64748B" FontSize="12" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                                    <Label Text="&lt;" TextColor="#64748B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="1" TextColor="White" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="2" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="3" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="..." TextColor="#64748B" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="240" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="&gt;" TextColor="#64748B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Tarjeta Flotante Overlay: Auto-Reprocess Active (Bottom Right) -->
                    <Border Stroke="#3B82F6" StrokeThickness="1" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="15" WidthRequest="300" HeightRequest="65" HorizontalOptions="End" VerticalOptions="End" Margin="0, 0, 15, 15" ToolTipProperties.Text="El background worker reintentará procesar los errores de forma automática cada 5 minutos">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <!-- Circular Lightning Icon -->
                            <Border Grid.Column="0" BackgroundColor="#263B82F6" StrokeThickness="0" StrokeShape="RoundRectangle 15" WidthRequest="30" HeightRequest="30" Padding="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Path Data="M7 2v11h3v9l7-12h-4l4-8z" Fill="#3B82F6" WidthRequest="10" HeightRequest="14" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <!-- Textos -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Auto-Reprocess active" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="3 files scheduled for retry in 2 mins." FontSize="10" TextColor="#94A3B8"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= BARRA DE ESTADO INFERIOR GLOBAL ================= -->
            <Border StrokeThickness="0" BackgroundColor="#111625" Padding="20, 8" HeightRequest="35" VerticalOptions="End">
                <Label Text="{Binding StatusMessage}" FontSize="11" TextColor="#94A3B8" FontAttributes="Italic" VerticalOptions="Center"/>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
